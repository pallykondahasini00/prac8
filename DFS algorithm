#include <iostream>
using namespace std;

int a[10][10], n;
bool visited[10] = {false};

void DFS(int v) {
    visited[v] = true;
    cout << v << " ";

    for (int i = 0; i < n; i++) {
        if (a[v][i] && !visited[i])
            DFS(i);
    }
}

int main() {
    int start;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];

    cout << "Enter starting vertex (0 to n-1): ";
    cin >> start;

    cout << "DFS Traversal: ";
    DFS(start);

    return 0;
}
