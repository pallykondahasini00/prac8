#include <iostream>
#include <queue>
using namespace std;

int main() {
    int n, a[10][10], start;
    bool visited[10] = {false};

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> a[i][j];

    cout << "Enter starting vertex (0 to n-1): ";
    cin >> start;

    queue<int> q;
    q.push(start);
    visited[start] = true;

    cout << "BFS Traversal: ";

    while (!q.empty()) {
        int v = q.front();
        q.pop();
        cout << v << " ";

        for (int i = 0; i < n; i++) {
            if (a[v][i] && !visited[i]) {
                q.push(i);
                visited[i] = true;
            }
        }
    }

    return 0;
}
